{
  "name": "@torkflow/platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "torkflow workflow automation platform — TypeScript on Cloudflare Workers + Workflows",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply torkflow --local",
    "migrate:remote": "wrangler d1 migrations apply torkflow --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/node": "^26.2.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^3.99.0"
  }
}
